apt-get update
apt-get install -y --no-install-recommends \
  ca-certificates \
  git \
  snapd \
  pkg-config \
  libwayland-dev \
  xvfb \
  ffmpeg \
  pre-commit \
  pluma \
  qterminal \
  qtwayland5 \
  qt6-wayland

cat <<'EOF' > /etc/profile.d/mir-ci.sh
export UV_PROJECT_ENVIRONMENT="$HOME/.venv"
export VIRTUAL_ENV="$UV_PROJECT_ENVIRONMENT"
export PATH="$UV_PROJECT_ENVIRONMENT/bin:$PATH"
EOF
